# ==============================================================================
# DC VOLTAGE AI NVR — ENVIRONMENT CONFIGURATION
# Developer: DC VOLTAGE NETWORK
# Product: DC VOLTAGE AI NVR
# Tagline: Intelligent Surveillance. Zero Blind Spots.
# ==============================================================================

# System Timezone
TIMEZONE=Asia/Kolkata

# Hardware Profile Selection
# Options: A (Older Laptop/PC), B (Standard PC), C (Advanced Server), D (Enterprise Cluster)
DCV_PROFILE=B

# Image Tag
DCV_IMAGE=dcvoltage/ai-nvr:latest

# Shared Memory Allocation (Formula: Width * Height * 1.5 * FrameCount * Cameras)
# Profile A: 256mb | Profile B: 512mb | Profile C: 1024mb | Profile D: 2048mb
SHM_SIZE=512mb

# Paths
CONFIG_PATH=./config
STORAGE_PATH=./storage

# In-Memory Cache Size (Bytes) - default 1GB
TMPFS_CACHE_SIZE=1000000000

# RTSP Restream & Authentication Secret
RTSP_PASSWORD=dcv_secure_vault_pass

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Assistant Configuration
# Options: ollama, openai, gemini, offline
AI_ASSISTANT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=
OPENAI_API_KEY=
